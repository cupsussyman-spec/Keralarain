# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://keralarain.com

# ─── Google Tag Manager ───────────────────────────────────────────────────────
# Create container at tagmanager.google.com → copy the GTM-XXXXXXX ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Only needed if you are NOT using GTM to load GA4.
# If GTM is set up above, configure the GA4 tag inside GTM instead.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Search Console ────────────────────────────────────────────────────
# Paste the content value from the <meta name="google-site-verification"> tag
# e.g. "abc123xyz" from <meta name="google-site-verification" content="abc123xyz">
NEXT_PUBLIC_GSC_VERIFICATION=your_verification_token_here

# ─── IP Geolocation (optional — Vercel geo headers are used in production) ────
# ipapi.co gives 1 000 req/day free (no key). For higher limits use ipinfo.io.
IPINFO_TOKEN=your_ipinfo_token_here
